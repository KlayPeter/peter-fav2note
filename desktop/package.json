{
    "name":  "fav2note-desktop",
    "version":  "0.1.0",
    "private":  true,
    "description":  "fav2note 桌面端（Electron 外壳 + Python sidecar）",
    "main":  "main.js",
    "scripts":  {
                    "dev":  "electron .",
                    "dist":  "electron-builder --win nsis"
                },
    "devDependencies":  {
                            "electron":  "^31.0.0",
                            "electron-builder":  "^24.13.3"
                        },
    "build":  {
                  "appId":  "com.klaypeter.fav2note",
                  "productName":  "fav2note",
                  "directories":  {
                                      "output":  "../dist"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "loading.html"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "../dist/backend",
                                             "to":  "backend",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         }
                                     ],
                  "win":  {
                              "target":  [
                                             "nsis"
                                         ],
                              "signAndEditExecutable":  false
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true
                           }
              }
}
