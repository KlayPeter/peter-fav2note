# 复制为 .env 后填写。不要把 .env 提交到仓库。

# LLM（任何 OpenAI 兼容接口）
FAV2NOTE_API_KEY=sk-xxxxxxxx
FAV2NOTE_BASE_URL=https://api.deepseek.com/v1
FAV2NOTE_MODEL=deepseek-chat

# 语音转写
FAV2NOTE_ASR_MODEL=medium
FAV2NOTE_ASR_DEVICE=auto

# 工具路径（不在 PATH 里时填绝对路径）
FAV2NOTE_FFMPEG=ffmpeg
FAV2NOTE_FFPROBE=ffprobe

# 每条笔记配几张截图
FAV2NOTE_FRAMES=5
